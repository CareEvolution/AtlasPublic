<?xml version="1.0" encoding="UTF-8"?>
<Configuration>
    <Properties>
        <property name="logging.format.console">${spring:logging.format.console}</property>
    </Properties>
    <Appenders>
        <RollingFile name="audit" fileName="${spring:webapi.audit-trail.log-file}"
            filePattern="/tmp/atlas/audit/audit-%d{yyyy-MM-dd}-%i.log">
          <PatternLayout>
            <Pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} DFGAtlas %p %c %t | %m %X %x%n</Pattern>
          </PatternLayout>
          <Policies>
            <TimeBasedTriggeringPolicy interval="1" modulate="true" />
          </Policies>
        </RollingFile>
        <Async name="audit-async">
          <AppenderRef ref="audit"/>
        </Async>
        <RollingFile name="audit-extra" fileName="${spring:webapi.audit-trail.extra-log-file}"
            filePattern="/tmp/atlas/audit/audit-extra-%d{yyyy-MM-dd}-%i.log">
          <PatternLayout>
            <Pattern>%m%n</Pattern>
          </PatternLayout>
          <Policies>
            <TimeBasedTriggeringPolicy interval="1" modulate="true" />
          </Policies>
        </RollingFile>
        <Async name="audit-extra-async">
          <AppenderRef ref="audit-extra"/>
        </Async>
        <Console name="HumanConsole" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} DFGAtlas %p %c %t | %m %X %x%n" />
        </Console>
        <Console name="JSONConsole" target="SYSTEM_OUT" immediateFlush="true" direct="true">
            <JsonTemplateLayout eventTemplateUri="classpath:AtlasLayout.json" />
        </Console>
    </Appenders>
    <Loggers>
        <Root level="${spring:logging.level.root}">
          <AppenderRef ref="${logging.format.console}" />
        </Root>
        <logger name="audit" level="info">
            <AppenderRef ref="audit-async" />
        </logger>
        <logger name="audit-extra" level="info">
            <AppenderRef ref="audit-extra-async" />
        </logger>
        <logger name="org.springframework.web" level="${spring:logging.level.org.springframework.web}" additivity="false">
          <AppenderRef ref="${logging.format.console}" />
        </logger>
        <logger name="org.springframework.jdbc.core" level="${spring:logging.level.org.springframework.jdbc.core}" additivity="false">
          <AppenderRef ref="${logging.format.console}" />
        </logger>
        <logger name="org.ohdsi.webapi.util.CancelableJdbcTemplate" level="${spring:logging.level.org.ohdsi.webapi.util.CancelableJdbcTemplate}" additivity="false">
          <AppenderRef ref="${logging.format.console}" />
        </logger>
        <logger name="org.hibernate.SQL" level="${spring:logging.level.org.hibernate.SQL}" additivity="false">
          <AppenderRef ref="${logging.format.console}" />
        </logger>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="${spring:logging.level.org.hibernate.type.descriptor.sql.BasicBinder}" additivity="false">
          <AppenderRef ref="${logging.format.console}" />
        </logger>
        <logger name="org.hibernate.type.descriptor.sql" level="${spring:logging.level.org.hibernate.type.descriptor.sql}" additivity="false">
          <AppenderRef ref="${logging.format.console}" />
        </logger>
    </Loggers>
</Configuration>